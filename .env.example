# Factory
FACTORY_MODE=replay
FACTORY_COLLECTOR_ID=c_hn_digest_factory
FACTORY_HN_URL=https://news.ycombinator.com
FACTORY_APP_PORT=3000
# Tests only: override repo root
# FACTORY_ROOT=/tmp/factory-test

# Bright Data (required when FACTORY_MODE=live)
BRIGHTDATA_API_KEY=
# Alternate collector id env (lower precedence than FACTORY_COLLECTOR_ID)
BRIGHTDATA_COLLECTOR_ID=

# Port (optional — pipeline never fails if these are empty)
PORT_CLIENT_ID=
PORT_CLIENT_SECRET=
PORT_API_URL=https://api.getport.io
PORT_MCP_URL=

# SigNoz / OTLP (optional — export failures are swallowed)
OTEL_EXPORTER_OTLP_ENDPOINT=https://ingest.us2.signoz.cloud:443
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=zero-downtime-factory
# W3C trace context, inherited by child processes
TRACEPARENT=
# Set to 1 to force a no-op tracer
FACTORY_OTEL_DISABLED=

# ---------- HYDRA (sibling of the factory, default replay) ----------
HYDRA_MODE=replay
HYDRA_ENV=hackathon
HYDRA_DB_PATH=./hydra.duckdb
HYDRA_DETECT_INTERVAL_S=15
HYDRA_HEAL_BUDGET_PER_HOUR=5
HYDRA_FINGERPRINT_ESCALATION=3
HYDRA_APPROVAL_TIMEOUT_S=300
HYDRA_BACKOFF_BASE_S=0
HYDRA_OTEL_DISABLED=
BRIGHTDATA_API_TOKEN=
BRIGHTDATA_GROUPS=advanced_scraping,browser,research
# Amazon Products scraper: https://brightdata.com/cp/datasets/browse/gd_l7q7dkf244hwjntr0?id=hl_bbd9eb9a
BRIGHTDATA_DATASET_ID=gd_l7q7dkf244hwjntr0
BRIGHTDATA_COLLECTION_ID=hl_bbd9eb9a
WEB_UNLOCKER_ZONE=
BROWSER_ZONE=
SIGNOZ_REGION=us2
SIGNOZ_API_KEY=
SIGNOZ_INSTANCE_URL=https://kind-wolf.us2.signoz.cloud
SIGNOZ_INGESTION_KEY=
ANTHROPIC_API_KEY=

# Public live dashboard (Amazon catalog + self-heal loop)
HYDRA_DASHBOARD_BIND=0.0.0.0
HYDRA_DASHBOARD_PORT=8080
# If set, POST /api/break and POST /api/heal require this token
HYDRA_DASHBOARD_TOKEN=
# 1 = show Break on the page and allow POST without a token (demo)
HYDRA_DASHBOARD_CONTROLS=1
HYDRA_DASHBOARD_INTERVAL_S=3
HYDRA_DASHBOARD_SOURCE=amazon_products
# Isolated live/judge dashboard (make hydra-dashboard-live). Replay on :8080 is unchanged.
# HYDRA_DASHBOARD_LIVE_PORT=8081
# HYDRA_DASHBOARD_LIVE_INTERVAL_S=60
# HYDRA_LIVE_DB_PATH=./hydra-live.duckdb
# HYDRA_JUDGE_LIVE_PATH=./data/hydra-judge.json
# HYDRA_JUDGE_FAULTS_PATH=./data/hydra-judge-faults.json
