# Factory
FACTORY_MODE=replay
FACTORY_COLLECTOR_ID=c_hn_digest_factory
FACTORY_HN_URL=https://news.ycombinator.com
FACTORY_APP_PORT=3000
# Tests only: override repo root
# FACTORY_ROOT=/tmp/factory-test

# Bright Data (required when FACTORY_MODE=live)
BRIGHTDATA_API_KEY=
# Alternate collector id env (lower precedence than FACTORY_COLLECTOR_ID)
BRIGHTDATA_COLLECTOR_ID=

# Port (optional — pipeline never fails if these are empty)
PORT_CLIENT_ID=
PORT_CLIENT_SECRET=
PORT_API_URL=https://api.getport.io
PORT_MCP_URL=

# SigNoz / OTLP (optional — export failures are swallowed)
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=zero-downtime-factory
# W3C trace context, inherited by child processes
TRACEPARENT=
# Set to 1 to force a no-op tracer
FACTORY_OTEL_DISABLED=
