# Secrets
.env
.env.*
!.env.example

# Dependencies
node_modules/

# Runtime factory state (INV-1: never commit latest/candidate/state)
data/latest.json
data/candidate.json
data/state.json
data/.factory.lock
data/.broken
data/.healed
data/raw/*
!data/raw/.gitkeep
data/snapshots/*
!data/snapshots/.gitkeep
port/state/*
!port/state/.gitkeep

# Logs and junk
*.log
tmp/
.DS_Store
.idea/
.vscode/
*.swp

# Python leftovers from the scaffold
.venv/
__pycache__/
.pytest_cache/
.mypy_cache/
hydra.duckdb
hydra.duckdb.wal

# OS
Thumbs.db
