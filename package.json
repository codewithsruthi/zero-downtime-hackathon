{
  "name": "zero-downtime-factory",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "factory": "./bin/factory"
  },
  "scripts": {
    "test": "node --test --test-concurrency=1 tests/unit/*.test.js tests/integration/*.test.js tests/chaos/*.test.js tests/app/*.test.js tests/demo/*.test.js",
    "start": "node --import ./app/instrumentation.js app/server.js",
    "vercel-build": "node scripts/vercel-build.mjs"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/core": "^1.30.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.57.2",
    "@opentelemetry/resources": "^1.30.1",
    "@opentelemetry/sdk-trace-base": "^1.30.1",
    "@opentelemetry/sdk-trace-node": "^1.30.1",
    "@opentelemetry/semantic-conventions": "^1.28.0",
    "express": "^4.21.2"
  }
}
